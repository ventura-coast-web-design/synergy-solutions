<section class="hero" aria-labelledby="hero-heading">
    <div class="hero__inner">
        <h1 id="hero-heading" class="hero__headline">
            <span class="hero__headline-line">Empowering</span>
            <span class="hero__headline-line hero__headline-line--accent">Your Team</span>
        </h1>

        <div class="hero__card">
            <div class="hero__card-body">
                <p class="hero__subhead">
                    <span class="hero__circle-word">Inspiring</span>
                    team <strong class="hero__highlight">connection</strong>, <strong class="hero__highlight">engagement</strong>, and <strong class="hero__highlight">loyalty</strong>
                    in an age of <span class="hero__squiggle">growing</span> disconnection.
                </p>
                <div class="hero__actions">
                    <a href="/contact" class="hero__btn hero__btn--primary">Book Synergy Solutions</a>
                    {# <a href="#watch" class="hero__btn hero__btn--ghost">
                        <span class="hero__play" aria-hidden="true"></span>
                        Watch Jonathan in action
                    </a> #}
                </div>
            </div>

            <div class="hero__figure" data-hero-rotate>
                <img
                    src="/assets/images/jonny.png"
                    alt="Jonathan Wisniewski, keynote speaker"
                    class="hero__photo hero__photo--active"
                    data-hero-photo="0"
                    width="520"
                    height="640"
                    decoding="async"
                    fetchpriority="high"
                >
                <img
                    src="/assets/images/alison.png"
                    alt="Alison Matthey, lead facilitator"
                    class="hero__photo"
                    data-hero-photo="1"
                    width="520"
                    height="520"
                    decoding="async"
                    loading="eager"
                    aria-hidden="true"
                >
                <p class="hero__credentials" aria-live="polite">
                    <span class="hero__cred-name">Jonathan Wisniewski</span><br>
                    <span class="hero__cred-line2">Keynote speaker</span><br>
                    <span class="hero__cred-line3">Employee engagement</span>
                </p>
            </div>
        </div>
    </div>
</section>
