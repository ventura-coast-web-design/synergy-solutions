<section class="services" id="services" aria-labelledby="services-heading">
    <div class="services__glow" aria-hidden="true"></div>
    <div class="services__inner">
        <h2 id="services-heading" class="services__title">Services</h2>
        <p class="services__lede">Programs tailored to leaders, teams, and organizations—delivered with energy and practical tools.</p>
        <ul class="services__list" role="list">
            {% for service in services %}
            {% if loop.index0 < 3 %}
            <li class="services__item"><span class="services__label">{{ service.title }}</span></li>
            {% endif %}
            {% endfor %}
        </ul>
        <div class="services__cta">
            <a href="/services/" class="services__cta-button">View all services</a>
        </div>
    </div>
</section>
